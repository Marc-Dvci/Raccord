# ---------------------------------------------------------------------------
# Raccord configuration
# Copy to .env. The full local demo runs with ZERO credentials set.
# ---------------------------------------------------------------------------

# --- Runtime mode ----------------------------------------------------------
# offline  : deterministic reasoning core, no network calls (default)
# gemini   : Gemini / ADK agents drive synthesis + communication
RACCORD_REASONING_MODE=offline

# --- Google Cloud (optional; enables the Gemini/ADK reasoning plane) -------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# For API-key mode instead of Vertex:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=
RACCORD_GEMINI_MODEL=gemini-3.7-flash
RACCORD_GEMINI_LOCATION=global
# Agent Engine is a regional runtime even when the Gemini endpoint is global.
RACCORD_AGENT_ENGINE_LOCATION=us-central1
# Stable GA fallback if 3.7 is unavailable in a constrained region: gemini-3.6-flash
# Set this to the resource name returned by tools/deploy_agent_engine.py.
# Blank uses Vertex AI directly through ADK.
RACCORD_AGENT_ENGINE_RESOURCE=
# A selected Gemini mode fails readiness on missing credentials/dependencies.
RACCORD_REASONING_FAIL_OPEN=false

# --- Grafana ---------------------------------------------------------------
# Local docker-compose stack (default) --------------------------------------
RACCORD_GRAFANA_URL=http://localhost:3000
RACCORD_GRAFANA_SERVICE_ACCOUNT_TOKEN=
RACCORD_PROMETHEUS_URL=http://localhost:9090
RACCORD_LOKI_URL=http://localhost:3100
RACCORD_TEMPO_URL=http://localhost:3200
RACCORD_PYROSCOPE_URL=http://localhost:4040
RACCORD_OTLP_ENDPOINT=http://localhost:4318
# Grafana Cloud OTLP uses the stack/instance id and a metrics/logs/traces write token.
# These are distinct from the Grafana service-account token used by the API/MCP server.
RACCORD_OTLP_USERNAME=
RACCORD_OTLP_AUTH_TOKEN=

# Grafana MCP -------------------------------------------------------------
# transport: stub | stdio | http
#   stub  : in-process MCP server implementing the same tool surface (no creds)
#   stdio : official grafana/mcp-grafana binary or docker image over stdio
#   http  : streamable-HTTP, to the local mcp-grafana container or Grafana Cloud
RACCORD_MCP_TRANSPORT=stub
RACCORD_MCP_STDIO_COMMAND=docker
RACCORD_MCP_STDIO_ARGS=run,--rm,-i,-e,GRAFANA_URL,-e,GRAFANA_SERVICE_ACCOUNT_TOKEN,grafana/mcp-grafana:1.0.0,-t,stdio
# For the local server started by `docker compose --profile mcp up -d mcp-grafana`:
#   RACCORD_MCP_TRANSPORT=http
#   RACCORD_MCP_HTTP_URL=http://localhost:8000/mcp
RACCORD_MCP_HTTP_URL=https://mcp.grafana.com/mcp
# Bearer credential presented to an HTTP MCP endpoint. For unattended Cloud Run
# this is the high-entropy token generated for Raccord's gateway, not a Grafana token.
RACCORD_MCP_BEARER_TOKEN=

# How the MCP *server* should reach Grafana, which is not always how we reach
# it: the official server usually runs in a container, where our
# http://localhost:3000 is the container itself. Sent as X-Grafana-URL only when
# set; leave blank for docker-compose, which configures the server directly.
# Grafana Cloud's hosted endpoint needs it.
RACCORD_MCP_GRAFANA_URL=

# Only the Cloud Run gateway process consumes these. The official MCP sidecar
# remains on localhost and is never exposed directly.
RACCORD_MCP_GATEWAY_TOKEN=
RACCORD_MCP_UPSTREAM_URL=http://127.0.0.1:8000/mcp
RACCORD_MCP_UPSTREAM_HEALTH_URL=http://127.0.0.1:8000/healthz

# --- Telemetry export ------------------------------------------------------
# Push probe findings, component logs, media-path spans and change annotations
# into the Grafana stack, so the agent can read them back through MCP. Off by
# default: the offline demo and the 1,000-scenario benchmark must not depend on
# a Grafana being there. Turn it on for the real-MCP path, which otherwise
# queries an empty stack.
RACCORD_EXPORT_TELEMETRY=false

# --- Grafana Agent Observability -----------------------------------------
# Values come from Grafana Cloud > Agent Observability > Configuration.
# Leave AGENTO11Y_ENDPOINT blank to disable the integration locally.
AGENTO11Y_ENDPOINT=
AGENTO11Y_PROTOCOL=http
AGENTO11Y_AUTH_MODE=basic
AGENTO11Y_AUTH_TENANT_ID=
AGENTO11Y_AUTH_TOKEN=

# --- Security --------------------------------------------------------------
# HMAC key for approval tokens. Generated on first run if left blank.
RACCORD_APPROVAL_SIGNING_KEY=
RACCORD_APPROVAL_TTL_SECONDS=300
# true is safe only for the isolated simulator and enables the one-click demo.
# In production, set false and let IAP supply the trusted identity header.
RACCORD_DEMO_MODE=true
RACCORD_TRUSTED_IDENTITY_HEADER=X-Goog-Authenticated-User-Email
RACCORD_OPERATOR_ROLE_BINDINGS_JSON={}

# --- Google Cloud evidence (optional) -------------------------------------
RACCORD_EVIDENCE_BUCKET=
RACCORD_PROBE_FINDINGS_TOPIC=
RACCORD_ANALYTICS_DATASET=
RACCORD_ANALYTICS_TABLE_NAME=incident_outcomes
RACCORD_CLOUD_PERSISTENCE_STRICT=false

# --- Storage ---------------------------------------------------------------
RACCORD_DATA_DIR=./var
RACCORD_API_PORT=8080
