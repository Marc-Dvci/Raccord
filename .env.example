# ---------------------------------------------------------------------------
# AccessPulse configuration
# Copy to .env. The full local demo runs with ZERO credentials set.
# ---------------------------------------------------------------------------

# --- Runtime mode ----------------------------------------------------------
# offline  : deterministic reasoning core, no network calls (default)
# gemini   : Gemini / ADK agents drive synthesis + communication
AP_REASONING_MODE=offline

# --- Google Cloud (optional; enables the Gemini/ADK reasoning plane) -------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# For API-key mode instead of Vertex:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=
AP_GEMINI_MODEL=gemini-2.5-pro

# --- Grafana ---------------------------------------------------------------
# Local docker-compose stack (default) --------------------------------------
AP_GRAFANA_URL=http://localhost:3000
AP_GRAFANA_SERVICE_ACCOUNT_TOKEN=
AP_PROMETHEUS_URL=http://localhost:9090
AP_LOKI_URL=http://localhost:3100
AP_TEMPO_URL=http://localhost:3200
AP_PYROSCOPE_URL=http://localhost:4040
AP_OTLP_ENDPOINT=http://localhost:4318

# Grafana MCP -------------------------------------------------------------
# transport: stub | stdio | http
#   stub  : in-process MCP server implementing the same tool surface (no creds)
#   stdio : official grafana/mcp-grafana binary or docker image over stdio
#   http  : streamable-HTTP, to the local mcp-grafana container or Grafana Cloud
AP_MCP_TRANSPORT=stub
AP_MCP_STDIO_COMMAND=docker
AP_MCP_STDIO_ARGS=run,--rm,-i,-e,GRAFANA_URL,-e,GRAFANA_SERVICE_ACCOUNT_TOKEN,mcp/grafana,-t,stdio
# For the local server started by `docker compose --profile mcp up -d mcp-grafana`:
#   AP_MCP_TRANSPORT=http
#   AP_MCP_HTTP_URL=http://localhost:8000/mcp
AP_MCP_HTTP_URL=https://mcp.grafana.com/mcp

# How the MCP *server* should reach Grafana, which is not always how we reach
# it: the official server usually runs in a container, where our
# http://localhost:3000 is the container itself. Sent as X-Grafana-URL only when
# set; leave blank for docker-compose, which configures the server directly.
# Grafana Cloud's hosted endpoint needs it.
AP_MCP_GRAFANA_URL=

# --- Telemetry export ------------------------------------------------------
# Push probe findings, component logs, media-path spans and change annotations
# into the Grafana stack, so the agent can read them back through MCP. Off by
# default: the offline demo and the 1,000-scenario benchmark must not depend on
# a Grafana being there. Turn it on for the real-MCP path, which otherwise
# queries an empty stack.
AP_EXPORT_TELEMETRY=false

# --- Security --------------------------------------------------------------
# HMAC key for approval tokens. Generated on first run if left blank.
AP_APPROVAL_SIGNING_KEY=
AP_APPROVAL_TTL_SECONDS=300

# --- Storage ---------------------------------------------------------------
AP_DATA_DIR=./var
AP_API_PORT=8080
