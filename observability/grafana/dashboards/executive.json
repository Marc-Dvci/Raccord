{
  "uid": "raccord-exec",
  "title": "Raccord / Executive accessibility reliability",
  "description": "Accessibility SLO attainment, error budget, protected sessions and restoration performance for the whole event portfolio.",
  "tags": [
    "raccord",
    "executive",
    "slo"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Raccord actions",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "matchAny": true,
          "tags": [
            "raccord",
            "approved-action",
            "recovery"
          ]
        }
      },
      {
        "name": "Deployments and configuration",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "type": "tags",
          "matchAny": true,
          "tags": [
            "deployment",
            "config",
            "change"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this shows",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Accessible Experience Reliability.** Every promised accessibility feature is treated as a production service with an objective and an error budget. A stream is only healthy when captions, described audio, the interpreter feed and the accessible player are all inside objective for every audience slice.\n\nStatus is never conveyed by colour alone: each tile shows its value and unit."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Accessibility SLO attainment",
      "description": "Share of evaluated SLO/slice pairs inside objective.",
      "datasource": {
        "type": "prometheus",
        "uid": "raccord-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg(raccord_slo_breached)",
          "datasource": {
            "type": "prometheus",
            "uid": "raccord-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.98
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Worst error budget consumed",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "raccord-prom"
      },
      "gridPos": {
        "x": 5,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(raccord_error_budget_consumed_ratio)",
          "datasource": {
            "type": "prometheus",
            "uid": "raccord-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Accessibility-enabled sessions protected",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "raccord-prom"
      },
      "gridPos": {
        "x": 10,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(raccord_sessions_caption_enabled) + sum(raccord_sessions_description_enabled) + sum(raccord_sessions_sign_enabled)",
          "datasource": {
            "type": "prometheus",
            "uid": "raccord-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Incidents open",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "raccord-prom"
      },
      "gridPos": {
        "x": 15,
        "y": 3,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(raccord_slo_breached > 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "raccord-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Mean time to recovery",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "raccord-prom"
      },
      "gridPos": {
        "x": 19,
        "y": 3,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(raccord_time_to_recovery_seconds)",
          "datasource": {
            "type": "prometheus",
            "uid": "raccord-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 180
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error budget consumed by SLO",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "raccord-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raccord_error_budget_consumed_ratio",
          "legendFormat": "{{slo}}",
          "datasource": {
            "type": "prometheus",
            "uid": "raccord-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Breaching SLO / slice matrix",
      "description": "Every SLO and audience slice currently outside objective.",
      "datasource": {
        "type": "prometheus",
        "uid": "raccord-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "raccord_slo_breached > 0",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "raccord-prom"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Sessions with an accessibility feature enabled",
      "description": "k-anonymised aggregates. No individual viewer, no inferred trait, never a disability profile.",
      "datasource": {
        "type": "prometheus",
        "uid": "raccord-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (territory) (raccord_sessions_caption_enabled)",
          "legendFormat": "{{territory}}",
          "datasource": {
            "type": "prometheus",
            "uid": "raccord-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Agent cost per incident",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "raccord-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(raccord_agent_cost_usd)",
          "legendFormat": "{{model}}",
          "datasource": {
            "type": "prometheus",
            "uid": "raccord-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
